{
  "expo": {
    "name": "Shalev Gym",
    "slug": "shalev-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ohad1989.shalevgym",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shalev Gym uses the microphone so you can log exercises by voice.",
          "speechRecognitionPermission": "Shalev Gym turns what you say into exercise logs."
        }
      ]
    ],
    "scheme": "shalevgym",
    "extra": {
      "eas": {
        "projectId": "70248306-1d43-4f26-91e8-370f3bb4f0dd"
      }
    },
    "owner": "ohad1989"
  }
}
